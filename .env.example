# Public site URL (for metadata)
NEXT_PUBLIC_SITE_URL=https://projectstream.vercel.app

# Supabase (required for auth, drafts, file downloads)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin password for publishing content (set a strong password!)
ADMIN_PASSWORD=change-me-before-deploy

# Shared secret for Gmail Apps Script → /api/ingest/email + /api/ingest/upload
# Generate with: openssl rand -hex 32
INGEST_SECRET=

# Ask AI + Auto-fill (use at least one)
# Groq is free for students: https://console.groq.com/keys
GROQ_API_KEY=
# Or OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional model overrides. Groq retires model names from time to time — if
# auto-fill warns about a decommissioned model, set a current one here.
GROQ_MODEL=
OPENAI_MODEL=
